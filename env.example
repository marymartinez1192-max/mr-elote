# ─── Supabase project ─────────────────────────────────────────
MRELOTE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
MRELOTE_SUPABASE_ANON_KEY=YOUR_ANON_KEY
MRELOTE_SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
MRELOTE_SUPABASE_JWKS_URI=https://YOUR_PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json
MRELOTE_SUPABASE_ISSUER=https://YOUR_PROJECT_REF.supabase.co/auth/v1
# JWT algorithm — default ES256 (Supabase ECC P-256). Override a RS256 si tu proyecto usa RSA.
#MRELOTE_SUPABASE_JWS_ALG=ES256

# ─── Supabase Postgres ────────────────────────────────────────
# Full JDBC URL (host+port+db+params en un solo valor).
# Local dev: jdbc:postgresql://db.<ref>.supabase.co:5432/postgres?sslmode=require
# Render / IPv4-only: jdbc:postgresql://aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
# (con Session Pooler, prependa el ref al user: mrelote_app.<ref>).
MRELOTE_SUPABASE_DB_HOST=jdbc:postgresql://db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require
MRELOTE_SUPABASE_DB_USER=mrelote_app
MRELOTE_SUPABASE_DB_PASSWORD=CHANGE_ME

# ─── Auth cookies ─────────────────────────────────────────────
# Set MRELOTE_COOKIE_SECURE=true when serving over HTTPS.
MRELOTE_ACCESS_COOKIE_NAME=mre_access
MRELOTE_REFRESH_COOKIE_NAME=mre_refresh
MRELOTE_COOKIE_DOMAIN=
MRELOTE_COOKIE_SECURE=false
MRELOTE_COOKIE_SAME_SITE=Strict

# ─── CORS ─────────────────────────────────────────────────────
# Comma-separated list of allowed origins (no wildcards when credentials=true).
MRELOTE_ALLOWED_ORIGINS=http://localhost:8081

# ─── Server ports ─────────────────────────────────────────────
MRELOTE_BACKEND_PORT=8080
MRELOTE_FRONTEND_PORT=8081

# ─── Admin seed (created via Supabase Admin API on boot) ──────
MRELOTE_ADMIN_NOMBRE=Administrador
MRELOTE_ADMIN_TELEFONO=0000000000
MRELOTE_ADMIN_CORREO=admin@mrelote.com
MRELOTE_ADMIN_PASSWORD=Admin1234!
MRELOTE_ADMIN_DIRECCION=MrElote HQ

# ─── Frontend → backend ───────────────────────────────────────
MRELOTE_API_BASE_URL=/api/v1
