{
  "info": {
    "name": "MrElote API",
    "description": "Colección de endpoints del proyecto académico MrElote. Base URL: {{baseUrl}}",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/api/v1",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string",
      "description": "Se llena automáticamente al hacer login"
    }
  ],
  "item": [
    {
      "name": "Autenticación",
      "item": [
        {
          "name": "Registrar usuario",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Juan Pérez\",\n  \"telefono\": \"3001234567\",\n  \"correo\": \"juan@example.com\",\n  \"password\": \"12345678\",\n  \"direccion\": \"Calle 10 # 20-30\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "HU-01. Crea una cuenta de cliente. Retorna el perfil del usuario (sin token). Correo único, contraseña mínimo 8 caracteres."
          },
          "response": []
        },
        {
          "name": "Iniciar sesión (cliente)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.token) {",
                  "    pm.collectionVariables.set('token', json.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo\": \"juan@example.com\",\n  \"password\": \"12345678\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "HU-02. Autentica con correo y contraseña. El token JWT se guarda automáticamente en la variable {{token}}."
          },
          "response": []
        },
        {
          "name": "Iniciar sesión (admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.token) {",
                  "    pm.collectionVariables.set('token', json.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo\": \"admin@mrelote.com\",\n  \"password\": \"admin1234\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "Login del administrador creado automáticamente al arrancar la app. El token se guarda en {{token}}."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Catálogo",
      "item": [
        {
          "name": "Listar categorías",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/categories",
              "host": ["{{baseUrl}}"],
              "path": ["categories"]
            },
            "description": "Retorna todas las categorías disponibles. Endpoint público."
          },
          "response": []
        },
        {
          "name": "Listar productos",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/products",
              "host": ["{{baseUrl}}"],
              "path": ["products"],
              "query": [
                {
                  "key": "categoryId",
                  "value": "1",
                  "description": "Filtrar por categoría (opcional)",
                  "disabled": true
                },
                {
                  "key": "available",
                  "value": "true",
                  "description": "Filtrar solo disponibles (opcional)",
                  "disabled": true
                }
              ]
            },
            "description": "HU-04. Lista productos con nombre, imagen, precio, descripción y disponibilidad. Filtros opcionales por categoría y disponibilidad. Endpoint público."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Carrito",
      "item": [
        {
          "name": "Ver carrito",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/cart",
              "host": ["{{baseUrl}}"],
              "path": ["cart"]
            },
            "description": "HU-08. Retorna el carrito activo del usuario con ítems, subtotales, tarifa de envío y total. 404 si no tiene carrito aún."
          },
          "response": []
        },
        {
          "name": "Agregar producto al carrito",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/cart/items",
              "host": ["{{baseUrl}}"],
              "path": ["cart", "items"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productoId\": 1,\n  \"cantidad\": 2\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "HU-07. Agrega un producto al carrito. Si el producto ya existe suma la cantidad. 422 si el producto no está disponible (RN-02)."
          },
          "response": []
        },
        {
          "name": "Actualizar cantidad de ítem",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/cart/items/1",
              "host": ["{{baseUrl}}"],
              "path": ["cart", "items", "1"],
              "variable": [
                {
                  "key": "productoId",
                  "value": "1",
                  "description": "ID del producto a actualizar en el carrito"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cantidad\": 3\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "HU-09. Actualiza la cantidad del producto indicado en el carrito del usuario. Subtotal y total se recalculan automáticamente."
          },
          "response": []
        },
        {
          "name": "Eliminar ítem del carrito",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/cart/items/1",
              "host": ["{{baseUrl}}"],
              "path": ["cart", "items", "1"]
            },
            "description": "HU-09. Elimina un ítem del carrito. Subtotal y total se recalculan automáticamente."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Pedidos",
      "item": [
        {
          "name": "Confirmar pedido",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/orders",
              "host": ["{{baseUrl}}"],
              "path": ["orders"]
            },
            "description": "HU-10. Crea un pedido en estado PENDIENTE a partir del carrito activo y lo vacía (RN-09). 422 si el carrito está vacío."
          },
          "response": []
        },
        {
          "name": "Historial de pedidos",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/orders?page=0&size=20",
              "host": ["{{baseUrl}}"],
              "path": ["orders"],
              "query": [
                { "key": "page", "value": "0" },
                { "key": "size", "value": "20" }
              ]
            },
            "description": "HU-13. Retorna todos los pedidos del usuario paginados, ordenados por fecha descendente."
          },
          "response": []
        },
        {
          "name": "Ver detalle de pedido",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/orders/1",
              "host": ["{{baseUrl}}"],
              "path": ["orders", "1"]
            },
            "description": "HU-11. Retorna el estado actual y detalle completo de un pedido del usuario."
          },
          "response": []
        },
        {
          "name": "Cancelar pedido",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/orders/1/cancel",
              "host": ["{{baseUrl}}"],
              "path": ["orders", "1", "cancel"]
            },
            "description": "HU-12. Cancela el pedido si está en estado PENDIENTE (RN-04). 422 si ya fue aceptado o cancelado."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Admin - Pedidos",
      "item": [
        {
          "name": "Listar todos los pedidos",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/admin/orders?page=0&size=20",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "orders"],
              "query": [
                { "key": "page", "value": "0" },
                { "key": "size", "value": "20" },
                { "key": "status", "value": "PENDIENTE", "description": "Filtro opcional por estado", "disabled": true }
              ]
            },
            "description": "HU-15. Lista todos los pedidos paginados. Filtro opcional por estado (PENDIENTE, ACEPTADO, EN_CAMINO, ENTREGADO, CANCELADO). Requiere ADMIN."
          },
          "response": []
        },
        {
          "name": "Actualizar estado de pedido",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/orders/1/status",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "orders", "1", "status"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"estado\": \"ACEPTADO\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "HU-15, HU-16. Transiciones válidas: PENDIENTE→ACEPTADO, PENDIENTE→CANCELADO, ACEPTADO→EN_CAMINO, ACEPTADO→CANCELADO, EN_CAMINO→ENTREGADO. 422 si la transición no es válida. Requiere ADMIN."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Admin - Configuración Negocio",
      "item": [
        {
          "name": "Obtener configuración",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/admin/business-config",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "business-config"]
            },
            "description": "HU-17. Retorna el horario de apertura/cierre y el estado del cierre manual. Requiere ADMIN."
          },
          "response": []
        },
        {
          "name": "Actualizar configuración",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/business-config",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "business-config"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"horarioApertura\": \"08:00:00\",\n  \"horarioCierre\": \"20:00:00\",\n  \"cerradoManual\": false\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "HU-17, HU-18. Actualiza horario y cierre manual. cerradoManual=true bloquea pedidos sin importar el horario (RN-06). Requiere ADMIN."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Negocio (público)",
      "item": [
        {
          "name": "Estado del negocio",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/business/status",
              "host": ["{{baseUrl}}"],
              "path": ["business", "status"]
            },
            "description": "RN-06. Consulta si el negocio está abierto. Considera horario configurado y cierre manual. Endpoint público."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Admin - Categorías",
      "item": [
        {
          "name": "Crear categoría",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/categories",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "categories"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Elotes\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "Crea una nueva categoría de productos. Requiere rol ADMIN."
          },
          "response": []
        },
        {
          "name": "Editar categoría",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/categories/1",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "categories", "1"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Elotes y Esquites\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "Actualiza el nombre de una categoría existente. Requiere rol ADMIN."
          },
          "response": []
        },
        {
          "name": "Eliminar categoría",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/categories/1",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "categories", "1"]
            },
            "description": "Elimina una categoría. Retorna 409 si tiene productos asociados. Requiere rol ADMIN."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Admin - Productos",
      "item": [
        {
          "name": "Crear producto",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/products",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "products"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Elote con queso\",\n  \"descripcion\": \"Elote asado con queso y mayonesa\",\n  \"precio\": 8500,\n  \"imagenUrl\": \"https://example.com/images/elote.jpg\",\n  \"disponible\": true,\n  \"categoriaId\": 1\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "HU-05. El administrador registra un nuevo producto. Requiere rol ADMIN."
          },
          "response": []
        },
        {
          "name": "Editar producto",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/products/1",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "products", "1"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Elote con queso y chile\",\n  \"descripcion\": \"Elote asado con queso, mayonesa y chile\",\n  \"precio\": 9500,\n  \"imagenUrl\": \"https://example.com/images/elote-chile.jpg\",\n  \"disponible\": true,\n  \"categoriaId\": 1\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "HU-05. Actualiza todos los datos de un producto existente. Requiere rol ADMIN."
          },
          "response": []
        },
        {
          "name": "Cambiar disponibilidad",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/products/1/availability",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "products", "1", "availability"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"disponible\": false\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "HU-06. Marca un producto como disponible o no disponible. Un producto no disponible no puede agregarse al carrito (RN-02). Requiere rol ADMIN."
          },
          "response": []
        }
      ]
    }
  ]
}
