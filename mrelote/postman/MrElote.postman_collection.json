                { "key": "size", "value": "20" },
                { "key": "status", "value": "PENDIENTE", "disabled": true }
              ]
            },
            "description": "HU-15. Filtro opcional `status`. Requiere ADMIN."
          },
          "response": []
        },
        {
          "name": "Actualizar estado",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/orders/1/status",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "orders", "1", "status"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"estado\": \"ACEPTADO\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "HU-15, HU-16. Transiciones válidas: PENDIENTE→ACEPTADO|CANCELADO, ACEPTADO→EN_CAMINO|CANCELADO, EN_CAMINO→ENTREGADO. Requiere ADMIN."
          },
          "response": []
        }
      ]
    },
