            "body": {
              "mode": "raw",
              "raw": "{\n  \"productoId\": 1,\n  \"cantidad\": 2\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "HU-07. Suma cantidad si ya existe. 422 si producto no disponible (RN-02)."
          },
          "response": []
        },
        {
          "name": "Actualizar cantidad",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/cart/items/1",
              "host": ["{{baseUrl}}"],
              "path": ["cart", "items", "1"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cantidad\": 3\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "HU-09. Path param: productoId."
          },
          "response": []
        },
        {
          "name": "Eliminar ítem",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/cart/items/1",
              "host": ["{{baseUrl}}"],
              "path": ["cart", "items", "1"]
            },
            "description": "HU-09."
          },
          "response": []
        }
      ]
    },
    {
